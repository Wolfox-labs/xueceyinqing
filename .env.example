# ===== 复制本文件为 .env 后填写。.env 不进仓库 =====

# ---- 大模型（必填）----
LLM_PROVIDER=openai
LLM_MODEL=your-model-id
LLM_BASE_URL=https://your-api.example.com/v1
LLM_API_KEY=your-api-key-here

# 图片/扫描件识别单独指定模型（留空则复用 LLM_MODEL）
VISION_MODEL=

# 可选：采样温度与推理强度
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=

# ---- 演示账号种子（默认关闭）----
# 开启后才会按下面的口令创建 student / teacher 两个账号，
# 口令为空则跳过，不会生成任何默认密码。
AUTH_SEED_DEMO_ACCOUNTS=false
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=

# scripts/accounts/ensure_demo_account.py 读取的口令
DEMO_ACCOUNT_PASSWORD=

# ---- 部署（docker-compose 使用）----
HTTP_BIND=127.0.0.1
HTTP_PORT=80
